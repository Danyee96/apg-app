# Support hosts that publish the repository root instead of public/.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# Serve only the application's explicit public entry points and assets.
# Everything else (storage, Git metadata, source and documentation) is private.
RewriteRule ^public/(index\.php|api\.php|app\.js|operator-cash\.js|wasooli\.js|delivery-workspace\.js|language\.js|translations\.js|style\.css)$ - [L]
RewriteRule ^public/?$ public/index.php [L]
RewriteRule ^$ public/index.php [L]
RewriteRule ^(index\.php|api\.php|app\.js|operator-cash\.js|wasooli\.js|delivery-workspace\.js|language\.js|translations\.js|style\.css)$ public/$1 [L]
RewriteRule ^ - [F,L]

# Versioned public assets are safe to retain; API and HTML remain private/no-store.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json text/html
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=[a-f0-9-]+(&|$)/"
</FilesMatch>
</IfModule>
