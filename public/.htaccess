Options -Indexes
DirectoryIndex index.php
<FilesMatch "\.(sqlite|db|sql|log|bak|json)$">
Require all denied
</FilesMatch>

# Versioned public assets are safe to retain; API and HTML remain private/no-store.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/css application/javascript text/javascript application/json text/html
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=[a-f0-9-]+(&|$)/"
</FilesMatch>
</IfModule>
